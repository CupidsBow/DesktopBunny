# 兔子名字（默认 Alice）
BUNNY_NAME=
# 本地兔子朋友：逗号分隔的名字，启动时预建空朋友档案（如 Bob,Carol）
BUNNY_FRIENDS=
# DeepSeek 配置
LLM_API_KEY=
LLM_CHAT_URL=
LLM_MODEL=
# QQ 机器人
QQ_APP_ID=
QQ_APP_SECRET=
QQ_IS_SANDBOX=false
QQ_INTENTS=33554432
QQ_WORKER_COUNT=8
# 单帧 inbox 上限：只把最近的这么多条未处理事件列给 LLM，其余顺延到下一帧；0 表示不限制
INBOX_MAX_EVENTS=20
